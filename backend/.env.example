# Variables de entorno de NotIA.
#
# Copia este archivo como backend/.env y completa los valores en tu computador.
# backend/.env está en .gitignore: nunca se sube al repositorio.
# Aquí solo van los nombres; no escribas valores reales en este archivo.

# --- Django ---
# Llaves aleatorias y distintas entre sí (el comando generar_llaves las entrega).
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
MFA_ENCRYPTION_KEY=
# Separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:4321

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notia
DB_USER=notia_app
DB_PASSWORD=
# En producción siempre es "require".
DB_SSLMODE=prefer

# --- Cuentas ---
DOMINIO_INSTITUCIONAL=aulaconecta.cl

# --- Voz (Azure AI Speech) ---
# "prueba" genera audios sintéticos sin red; "azure" necesita llave y región.
PROVEEDOR_VOZ=prueba
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
VOCES_DISPONIBLES=es-CL-CatalinaNeural,es-CL-LorenzoNeural

# --- Almacenamiento privado (solo en Azure) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER=
