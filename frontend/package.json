{
  "name": "notia-frontend",
  "version": "0.1.0",
  "description": "Pantallas de NotIA (Astro estático con islas Svelte)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/hash-csp.mjs",
    "preview": "astro preview",
    "lint": "eslint . --max-warnings 0",
    "check": "astro check",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.6",
    "astro": "7.4.12",
    "svelte": "5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
